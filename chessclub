    local bias = 0
    local isCastle = (from == "e1" and (to == "g1" or to == "c1"))
        or (from == "e8" and (to == "g8" or to == "c8"))
    local isPromo = move:sub(5, 5) ~= ""
    local quiet = not targetLower

    if targetLower then
        bias += profile.Aggression * math.min(0.16, (pieceValues[targetLower] or 0) * 0.018)
        bias += profile.Tactical * math.min(0.20, (pieceValues[targetLower] or 0) * 0.022)
    end

    if move:sub(5, 5) ~= "" then
        bias += profile.Aggression * 0.10 + profile.Tactical * 0.12 + profile.Endgame * 0.06
    end

    local centerDistance = math.abs(4.5 - tf) + math.abs(4.5 - tr)
    bias += math.max(0, 4.5 - centerDistance) * profile.Positional * 0.025

    if (from == "e1" and (to == "g1" or to == "c1")) or (from == "e8" and (to == "g8" or to == "c8")) then
        bias += profile.Calmness * 0.12 + profile.Positional * 0.08
    end

    if lower == "k" and math.abs(tf - ff) ~= 2 then
        bias -= profile.Calmness * 0.08
        bias += profile.Endgame * 0.08
    end

    if lower == "p" then
        bias += math.abs(tr - fr) * (profile.Aggression * 0.018 + profile.Endgame * 0.025)
    end

    if not targetLower and lower ~= "q" and lower ~= "k" then
        bias += profile.Trickiness * 0.075
    end

    if lower == "q" and not targetLower then
        bias -= profile.Calmness * 0.06
    end

    if profile.AlienGambit == true then
        bias += alienPatternBias(fen, move)
    end

    if profile.WillyAlien == true then
