    end

    if lower == "n" and from == "g5" and to == "f7" then
        bias += 1.85
        if targetLower == "p" then
            bias += 0.55
        end
    end

    if lower == "n" and from == "g1" and to == "f3" then
        bias += 0.52
    end

    if lower == "b" and from == "f1" and to == "c4" then
        bias += 0.42
    end

    if lower == "q" and from == "d1" and to == "e2" then
        bias += 0.24
    end

    if move:sub(5, 5) ~= "" then
        bias += 0.18
    end

    if targetLower and (targetLower == "p" or targetLower == "b") and lower ~= "q" then
        bias += 0.12
    end

    return bias
end

local function moveHeuristic(fen, move, matrix)

    if type(move) ~= "string" then
        return -math.huge
    end

    local from, to = move:sub(1, 2), move:sub(3, 4)
    local ff, fr = squareToCoords(from)
    local tf, tr = squareToCoords(to)

    if not ff or not tf or not matrix then
        return 0
    end

    local moving = matrix[fr][ff]
    local target = matrix[tr][tf]
    local movingLower = moving and moving:lower() or ""
    local targetLower = target and target ~= "." and target:lower() or nil
    local score = 0

    if targetLower then
        local victim = pieceValues[targetLower] or 0
        local attacker = pieceValues[movingLower] or 1
        score += victim * 14
        score += math.max(0, victim - attacker) * 4
    end

    if move:sub(5, 5) ~= "" then
        score += 48
    end

    if (from == "e1" and (to == "g1" or to == "c1")) or (from == "e8" and (to == "g8" or to == "c8")) then
        score += 10
    end

    local centerDistance = math.abs(4.5 - tf) + math.abs(4.5 - tr)
    score += math.max(0, 5 - centerDistance) * 1.8

    local profile = getAIProfile()

    if movingLower == "n" or movingLower == "b" then
        score += 2.5
        if (fr == 1 or fr == 8) and not targetLower then
            score += 4
        end
    elseif movingLower == "p" then
        local advance = math.abs(tr - fr)
        score += advance * (0.8 + profile.Aggression * 0.35 + profile.Endgame * 0.25)
    elseif movingLower == "r" then
        score += 1.5
    elseif movingLower == "q" then
        score -= 1.5 + math.max(0, profile.Calmness * 0.9)
    elseif movingLower == "k" and math.abs(tf - ff) ~= 2 then
        score -= 5 + math.max(0, profile.Aggression * 0.5)
    end

    if targetLower then
        score += profile.Aggression * (pieceValues[targetLower] or 0) * 2.2
        score += profile.Tactical * (pieceValues[targetLower] or 0) * 1.8
    end

    if move:sub(5, 5) ~= "" then
        score += profile.Aggression * 10 + profile.Tactical * 15 + profile.Endgame * 8
    end

    if (from == "e1" and (to == "g1" or to == "c1")) or (from == "e8" and (to == "g8" or to == "c8")) then
        score += profile.Calmness * 10 + profile.Positional * 7 + profile.Endgame * 3
    end

    local centerBonus = math.max(0, 5 - centerDistance)
    score += centerBonus * (profile.Positional * 2.0 + profile.Calmness * 0.45)

    if movingLower ~= "q" and movingLower ~= "k" and not targetLower then
        score += profile.Trickiness * 2.3
    end

    return score

end

local function styleCandidatePriority(fen, move, matrix)
    if type(move) ~= "string" or not matrix then
        return -math.huge
    end

    local base = moveHeuristic(fen, move, matrix)
    local from, to = move:sub(1, 2), move:sub(3, 4)
    local ff, fr = squareToCoords(from)
    local tf, tr = squareToCoords(to)
    if not ff or not tf then
        return base
    end

    local piece = matrix[fr][ff]
    local target = matrix[tr][tf]
    local lower = piece and piece:lower() or ""
    local targetLower = target and target ~= "." and target:lower() or nil
    local score = base
    local captureValue = targetLower and (pieceValues[targetLower] or 0) or 0
    local center = math.max(0, 4.5 - (math.abs(4.5 - tf) + math.abs(4.5 - tr)))
    local isCastle = (from == "e1" and (to == "g1" or to == "c1"))
        or (from == "e8" and (to == "g8" or to == "c8"))
    local isPromo = move:sub(5, 5) ~= ""
    local flank = (tf == 1 or tf == 8)
    local quiet = not targetLower

    if State.AIStyle == "Balanced" then
        return score
    elseif State.AIStyle == "Aggressive" then
        score += captureValue * 12
        score += (isPromo and 38 or 0)
        score += (lower == "q" and quiet and 7 or 0)
        score += ((tf >= 6 or tf <= 3) and (tr >= 5 or tr <= 4) and 4 or 0)
        score += (lower == "p" and math.abs(tr - fr) * 3.5 or 0)
    elseif State.AIStyle == "Calm" then
        score += isCastle and 46 or 0
        score += quiet and 12 or 0
        score += (lower == "n" or lower == "b") and 14 or 0
        score += center * 5
        score -= captureValue * 4
        score -= isPromo and 8 or 0
    elseif State.AIStyle == "Defensive" then
        score += isCastle and 58 or 0
        score += (lower == "k" and not isCastle and -25 or 0)
        score += quiet and 15 or 0
        score += (lower == "n" or lower == "b") and 9 or 0
        score -= captureValue > 3 and 5 or 0
        score -= flank and 4 or 0
    elseif State.AIStyle == "Tactical" then
        score += captureValue * 16
        score += (isPromo and 52 or 0)
        score += (lower == "n" and 9 or 0)
        score += (lower == "b" and center * 2.0 or 0)
        score += (targetLower == "k" and 80 or 0)
        score += (tf >= 5 and tr >= 5 and lower ~= "p" and 3 or 0)
    elseif State.AIStyle == "Trickery" then
        score += quiet and 34 or 0
        score += (lower == "n" and 24 or 0)
        score += (lower == "p" and flank and 22 or 0)
        score += (lower == "b" and not targetLower and 13 or 0)
        score += isPromo and 28 or 0
        score -= captureValue * 1.5
    elseif State.AIStyle == "Positional" then
        score += center * 15
        score += (lower == "n" or lower == "b") and 24 or 0
        score += (lower == "r" and (tf == 4 or tf == 5) and 8 or 0)
        score += quiet and 7 or 0
        score += isCastle and 14 or 0
        score -= (lower == "q" and quiet and 6 or 0)
    elseif State.AIStyle == "Endgame" then
        score += lower == "k" and 34 or 0
        score += lower == "p" and (math.abs(tr - fr) * 12 + ((tf == 4 or tf == 5) and 7 or 0)) or 0
        score += lower == "r" and 18 or 0
        score += captureValue == 1 and 16 or 0
        score += isPromo and 65 or 0
        score -= lower == "q" and quiet and 10 or 0
    elseif State.AIStyle == "Alien Gambit" then
        score += (lower == "n" and (to == "g5" or to == "e5" or to == "f7" or to == "e4") and 55 or 0)
        score += (lower == "b" and (to == "c4" or to == "b5" or to == "g5") and 25 or 0)
        score += (lower == "p" and (to == "e4" or to == "d4" or to == "f4") and 16 or 0)
        score += captureValue * 7
        score += quiet and 8 or 0
    elseif State.AIStyle == "Willy Alien" then
        score += (lower == "n" and 42 or 0)
        score += (lower == "b" and 21 or 0)
        score += flank and 30 or 0
        score += (lower == "p" and flank and 28 or 0)
        score += (quiet and not isCastle) and 18 or 0
        score += isPromo and 36 or 0
        score += (lower == "r" and (tf == 1 or tf == 8) and 15 or 0)
        score += captureValue * 4
    end

    return score
end

local function chooseCandidateMoves(fen, primaryMove, wanted)
    local moves = getLegalMoves(fen)
    if #moves == 0 then
        return primaryMove and {primaryMove} or {}
    end

    local matrix = boardToMatrix(fen)
    local ranked = {}
    local seen = {}

    for _, move in ipairs(moves) do
        if move ~= primaryMove then
            ranked[#ranked + 1] = {
                move = move,
                priority = styleCandidatePriority(fen, move, matrix),
            }
        end
    end

    table.sort(ranked, function(a, b)
        if a.priority == b.priority then
            return a.move < b.move
        end
        return a.priority > b.priority
    end)

    local result = {}
    local limit = math.max(2, math.min(wanted or 4, #moves + 1))

    if primaryMove then
        result[#result + 1] = primaryMove
        seen[primaryMove] = true
    end

    local alienBookMove = getAlienGambitPlanMove(fen)
    if alienBookMove and not seen[alienBookMove] and #result < limit then
        seen[alienBookMove] = true
        result[#result + 1] = alienBookMove
    end

    for _, entry in ipairs(ranked) do
        if #result >= limit then
            break
        end
        if not seen[entry.move] then
            seen[entry.move] = true
            result[#result + 1] = entry.move
        end
    end

    return result
end

local function getSmartCount()
    local base = tonumber(State.SearchTime) or 2.5
    local profile = getAIProfile()
    local maximum = profile.WillyAlien and 14 or 10
    local automatic = math.clamp(math.floor(base + (profile.WillyAlien and 5 or 2)), 4, maximum)

    if State.AIStyle == "Balanced" then
        return math.clamp(State.SecondChoiceCount or automatic, 3, maximum)
    end

    return math.clamp(math.max(State.SecondChoiceCount or 0, automatic), 5, maximum)
end

local function getSmartChildTime()

    local base = tonumber(State.SearchTime) or 2.5
    local profile = getAIProfile()
    local maximum = profile.WillyAlien and 1.70 or 1.15
    return math.clamp(base * 0.28 * (tonumber(profile.ThinkMultiplier) or 1), 0.22, maximum)

end

local function getSmartVerifyTime()

    local base = tonumber(State.SearchTime) or 2.5
    local profile = getAIProfile()
    local maximum = profile.WillyAlien and 2.00 or 1.55
    return math.clamp(base * 0.38 * (tonumber(profile.ThinkMultiplier) or 1), 0.25, maximum)

end

local function engineLineScore(fen, move, token, timeOverride)

    local nextFen = applyUCIMove(fen, move)
    if not nextFen then
        return nil, nil
    end

    if token and token ~= State.AnalysisToken then
        return nil, nil
    end

    local reply
    local replyScore
    local childTime = timeOverride or getSmartChildTime()

    if ActiveAPI and ActiveAPI.GetBestMoveFromFEN then
        local ok, a, b = pcall(function()
            return ActiveAPI:GetBestMoveFromFEN(nextFen, childTime)
        end)
        if ok then
            reply = a
            replyScore = b
        end
    end

    if not reply then
        reply = fallbackMove(nextFen)
    end

    if token and token ~= State.AnalysisToken then
        return nil, nil
    end

    if not reply then
        local mat = materialDetails(nextFen)
        if not mat then
            return move, nil
        end
        local mine = localSide()
        local score = mine == "w" and mat.balance or mine == "b" and -mat.balance or 0
        return move, score
    end

    local numeric = normalizeEngineScore(replyScore)
    if numeric then
        return reply, -numeric
    end

    return reply, nil

end

local function willyAlienMoveBias(fen, move)
    local profile = getAIProfile()
    if not profile or profile.WillyAlien ~= true or type(move) ~= "string" then
        return 0
    end

    local matrix = boardToMatrix(fen)
    if not matrix then
        return 0
    end

    local from, to = move:sub(1, 2), move:sub(3, 4)
    local ff, fr = squareToCoords(from)
    local tf, tr = squareToCoords(to)
    if not ff or not tf then
        return 0
    end

    local piece = matrix[fr][ff]
    local target = matrix[tr][tf]
    local lower = piece and piece:lower() or ""
    local targetLower = target and target ~= "." and target:lower() or nil
    local bias = 0

    local unusualKnightSquares = {
        c5 = true, e5 = true, g5 = true, b5 = true,
        d4 = true, f4 = true, a3 = true, h3 = true,
    }
    if lower == "n" and unusualKnightSquares[to] then
        bias += 0.105
    end

    if lower == "p" and (to:sub(1,1) == "a" or to:sub(1,1) == "h") then
        bias += 0.075
    end

    if lower == "b" and (to == "g2" or to == "b2" or to == "g7" or to == "b7") then
        bias += 0.080
    end

    if lower == "r" and (to == "a3" or to == "h3" or to == "a6" or to == "h6") then
        bias += 0.055
    end

    if lower == "q" and not targetLower then
        bias -= 0.045
    end

    if targetLower then
        bias += 0.025
    end

    if move:sub(5, 5) ~= "" then
        bias += 0.045
    end

    return math.clamp(bias, -0.08, 0.16)
end

local function styleMoveBias(fen, move)
    if type(move) ~= "string" then
        return 0
    end

    local profile = getAIProfile()
    local matrix = boardToMatrix(fen)
    if not matrix then
        return 0
    end

    local from, to = move:sub(1, 2), move:sub(3, 4)
    local ff, fr = squareToCoords(from)
    local tf, tr = squareToCoords(to)
    if not ff or not tf then
