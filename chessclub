local function findBoardGui()

    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")

    if not playerGui then

        return nil

    end

    local candidates = {}

    for _, obj in ipairs(playerGui:GetDescendants()) do

        if obj:IsA("Frame") or obj:IsA("ImageLabel") or obj:IsA("ImageButton") then

            local name = string.lower(obj.Name)

            local looksLikeBoard =

                name:find("chessboard", 1, true) or

                name == "board" or

                name:find("chess_board", 1, true) or

                (name:find("chess", 1, true) and name:find("board", 1, true))

            if obj.Visible then

                local size = obj.AbsoluteSize

                if size.X >= 180 and size.Y >= 180 then

                    local ratio = size.X / math.max(size.Y, 1)

                    local squarePenalty = math.abs(1 - ratio)

                    if looksLikeBoard then

                        squarePenalty -= 0.25

                    end

                    if squarePenalty <= 0.18 then

                        table.insert(candidates, {

                            object = obj,

                            area = size.X * size.Y,

                            penalty = squarePenalty

                        })

                    end

                end

            end

        end

    end

    table.sort(candidates, function(a, b)

        if a.penalty ~= b.penalty then

            return a.penalty < b.penalty

        end

        return a.area > b.area

    end)

    return candidates[1] and candidates[1].object or nil

