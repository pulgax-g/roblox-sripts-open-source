local function animateMoveMarker(marker, isDestination, token)

    if not marker then
        return
    end

    local stroke = marker:FindFirstChild("MoveStroke")
    local innerStroke = marker:FindFirstChild("InnerStroke")
    local core = marker:FindFirstChild("MoveCore")
    local scale = marker:FindFirstChild("MoveScale")

    marker.Visible = true
    marker.BackgroundTransparency = 1

    if stroke then
        stroke.Transparency = 1
    end

    if innerStroke then
        innerStroke.Transparency = 1
    end

    if core then
        core.BackgroundTransparency = 1
    end

    if scale then
        scale.Scale = 0.82
    end

    local entrance = TweenService:Create(
        marker,
        TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        {BackgroundTransparency = isDestination and 0.84 or 0.91}
    )

    local entranceScale = scale and TweenService:Create(
        scale,
        TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Scale = 1}
    )

    local strokeIn = stroke and TweenService:Create(
        stroke,
        TweenInfo.new(0.20, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {Transparency = isDestination and 0.08 or 0.18}
    )

    local innerIn = innerStroke and TweenService:Create(
        innerStroke,
        TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {Transparency = isDestination and 0.25 or 0.42}
    )

    local coreIn = core and TweenService:Create(
        core,
        TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {BackgroundTransparency = 0.08}
    )

    entrance:Play()
    if entranceScale then entranceScale:Play() end
    if strokeIn then strokeIn:Play() end
    if innerIn then innerIn:Play() end
    if coreIn then coreIn:Play() end

    task.spawn(function()
        entrance.Completed:Wait()
        while token == State.PulseToken
            and marker.Parent
            and State.HighlightBestMove
            and State.BestMove do

            local brightTransparency = isDestination and 0.78 or 0.87
            local dimTransparency = isDestination and 0.90 or 0.95

            local bright = TweenService:Create(
                marker,
                TweenInfo.new(0.72, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                {BackgroundTransparency = brightTransparency}
            )
            local brightScale = scale and TweenService:Create(
                scale,
                TweenInfo.new(0.72, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                {Scale = isDestination and 1.035 or 1.018}
