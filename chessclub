                {Transparency = isDestination and 0.02 or 0.10}
            )
            local brightInner = innerStroke and TweenService:Create(
                innerStroke,
                TweenInfo.new(0.72, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                {Transparency = isDestination and 0.15 or 0.30}
            )

            bright:Play()
            if brightScale then brightScale:Play() end
            if brightStroke then brightStroke:Play() end
            if brightInner then brightInner:Play() end
            bright.Completed:Wait()

            if token ~= State.PulseToken then
                break
            end

            local dim = TweenService:Create(
                marker,
                TweenInfo.new(0.72, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                {BackgroundTransparency = dimTransparency}
            )
            local dimScale = scale and TweenService:Create(
                scale,
                TweenInfo.new(0.72, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                {Scale = 1}
            )
            local dimStroke = stroke and TweenService:Create(
                stroke,
                TweenInfo.new(0.72, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                {Transparency = isDestination and 0.13 or 0.22}
            )
            local dimInner = innerStroke and TweenService:Create(
                innerStroke,
                TweenInfo.new(0.72, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                {Transparency = isDestination and 0.28 or 0.42}
            )

            dim:Play()
            if dimScale then dimScale:Play() end
            if dimStroke then dimStroke:Play() end
            if dimInner then dimInner:Play() end
            dim.Completed:Wait()
        end
    end)

