local function engineScoreToWinrates(score)

    local value = tonumber(score)
    if not value then
        return nil, nil, nil
    end

    if math.abs(value) > 25 then
        value /= 100
    end

    value = math.clamp(value, -8, 8)
    local base = 1 / (1 + math.exp(-1.15 * value))
    local draw = math.clamp(0.16 * math.exp(-math.abs(value) * 0.7), 0.025, 0.16)
    local decisive = 1 - draw
    local mine = base * decisive
    local opponent = (1 - base) * decisive

    return mine * 100, opponent * 100, draw * 100

end

