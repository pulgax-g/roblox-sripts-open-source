        bias += (lower == "q" and not targetLower and 0.035 or 0)
        bias += (lower == "p" and math.abs(tr - fr) * 0.010 or 0)
    elseif State.AIStyle == "Calm" then
        bias += isCastle and 0.18 or 0
        bias += quiet and 0.055 or 0
        bias += (lower == "n" or lower == "b") and 0.045 or 0
        bias -= (targetLower and 0.025 or 0)
    elseif State.AIStyle == "Defensive" then
        bias += isCastle and 0.24 or 0
        bias += quiet and 0.07 or 0
        bias -= (lower == "k" and not isCastle and 0.09 or 0)
        bias -= (lower == "p" and (to:sub(1,1) == "a" or to:sub(1,1) == "h") and 0.04 or 0)
    elseif State.AIStyle == "Tactical" then
        bias += targetLower and (pieceValues[targetLower] or 0) * 0.075 or 0
        bias += isPromo and 0.18 or 0
        bias += lower == "n" and 0.035 or 0
    elseif State.AIStyle == "Trickery" then
        bias += quiet and 0.12 or 0
        bias += lower == "n" and 0.075 or 0
        bias += (lower == "p" and (tf == 1 or tf == 8) and 0.065 or 0)
        bias += (lower == "b" and quiet and 0.045 or 0)
    elseif State.AIStyle == "Positional" then
        local c = math.max(0, 4.5 - (math.abs(4.5 - tf) + math.abs(4.5 - tr)))
        bias += c * 0.035
        bias += (lower == "n" or lower == "b") and 0.07 or 0
        bias += isCastle and 0.08 or 0
        bias += quiet and 0.025 or 0
    elseif State.AIStyle == "Endgame" then
        bias += lower == "k" and 0.12 or 0
        bias += lower == "p" and math.abs(tr - fr) * 0.022 or 0
        bias += lower == "r" and 0.055 or 0
        bias += targetLower == "p" and 0.065 or 0
        bias += isPromo and 0.18 or 0
    elseif State.AIStyle == "Alien Gambit" then
        bias += (lower == "n" and (to == "g5" or to == "e5" or to == "f7") and 0.20 or 0)
        bias += (lower == "b" and (to == "c4" or to == "b5") and 0.08 or 0)
        bias += (lower == "p" and (to == "e4" or to == "d4" or to == "f4") and 0.06 or 0)
    elseif State.AIStyle == "Willy Alien" then
        bias += lower == "n" and 0.13 or 0
        bias += lower == "b" and 0.055 or 0
        bias += (tf == 1 or tf == 8) and 0.075 or 0
        bias += (quiet and not isCastle) and 0.065 or 0
        bias += isPromo and 0.10 or 0
        bias += (lower == "r" and (tf == 1 or tf == 8) and 0.06 or 0)
    end

    return math.clamp(bias, -0.35, 2.80)
end

local function styleSelectLine(fen, lines, primaryNumeric)
    if type(lines) ~= "table" or #lines == 0 then
        return nil
    end

    local style = State.AIStyle
    local matrix = boardToMatrix(fen)

    table.sort(lines, function(a, b)
        if a.score == b.score then
            return (a.move or "") < (b.move or "")
        end
        return (a.score or -math.huge) > (b.score or -math.huge)
    end)

    local poolSizeByStyle = {
        Balanced = 1,
        Aggressive = 4,
        Calm = 3,
        Defensive = 3,
        Tactical = 5,
        Trickery = 6,
        Positional = 4,
        Endgame = 4,
        ["Alien Gambit"] = 7,
        ["Willy Alien"] = 9,
    }

    local rawWeightByStyle = {
        Balanced = 1.00,
        Aggressive = 0.30,
        Calm = 0.70,
        Defensive = 0.82,
        Tactical = 0.24,
        Trickery = 0.16,
        Positional = 0.55,
        Endgame = 0.48,
        ["Alien Gambit"] = 0.12,
        ["Willy Alien"] = 0.08,
    }

    local poolSize = math.min(poolSizeByStyle[style] or 3, #lines)
    local rawWeight = rawWeightByStyle[style] or 0.65

    if poolSize <= 1 then
        return lines[1]
    end

    local pool = {}
    for i = 1, poolSize do
        pool[#pool + 1] = lines[i]
    end

    local bestRaw = tonumber(lines[1].score) or -math.huge

    local function policyScore(line)
        local move = line.move
        local raw = tonumber(line.score) or -math.huge
        local rank = 0
        for i, candidate in ipairs(lines) do
            if candidate == line then
                rank = i
                break
            end
        end

        local rankBonus = math.max(0, poolSize + 1 - rank) * 0.035
        local styleValue = styleCandidatePriority(fen, move, matrix)
        local biasValue = styleMoveBias(fen, move)
        local weirdValue = (style == "Willy Alien") and willyAlienMoveBias(fen, move) or 0

        local normalizedRaw = raw - bestRaw

        if style == "Balanced" then
            return raw
        elseif style == "Aggressive" then
            return normalizedRaw * rawWeight
                + styleValue * 0.22
                + biasValue * 7.0
                + rankBonus
        elseif style == "Calm" then
            return normalizedRaw * rawWeight
                + styleValue * 0.18
                + biasValue * 5.5
                + rankBonus
        elseif style == "Defensive" then
            return normalizedRaw * rawWeight
                + styleValue * 0.22
                + biasValue * 6.2
                + rankBonus
        elseif style == "Tactical" then
            return normalizedRaw * rawWeight
                + styleValue * 0.34
                + biasValue * 9.5
                + rankBonus
        elseif style == "Trickery" then
            return normalizedRaw * rawWeight
                + styleValue * 0.40
                + biasValue * 12.0
                + rankBonus
        elseif style == "Positional" then
            return normalizedRaw * rawWeight
                + styleValue * 0.30
                + biasValue * 8.0
                + rankBonus
        elseif style == "Endgame" then
            return normalizedRaw * rawWeight
                + styleValue * 0.34
                + biasValue * 8.3
                + rankBonus
        elseif style == "Alien Gambit" then
            return normalizedRaw * rawWeight
                + styleValue * 0.46
                + biasValue * 14.0
                + rankBonus
        elseif style == "Willy Alien" then
            return normalizedRaw * rawWeight
                + styleValue * 0.38
                + biasValue * 11.5
                + weirdValue * 22.0
                + rankBonus
        end

        return normalizedRaw * rawWeight + styleValue * 0.20 + biasValue * 5.0
    end

    local chosen
    local chosenValue = -math.huge
    for _, line in ipairs(pool) do
        line.PolicyScore = policyScore(line)
        if line.PolicyScore > chosenValue then
            chosen = line
            chosenValue = line.PolicyScore
        elseif line.PolicyScore == chosenValue and chosen then
            if (line.score or -math.huge) > (chosen.score or -math.huge) then
                chosen = line
            end
        end
    end

    return chosen or lines[1]
end

local function smartChoicePlan(fen, primaryMove, token)
    local wanted = getSmartCount()
    local candidates = chooseCandidateMoves(fen, primaryMove, wanted)
    local lines = {}
    local childTime = getSmartChildTime()

    local primaryReply, primaryScore = engineLineScore(fen, primaryMove, token, childTime)
    if token ~= State.AnalysisToken then
        return primaryMove, primaryReply, primaryScore, lines
    end

    local primaryNumeric = tonumber(primaryScore)
    if primaryNumeric == nil then
        return primaryMove, primaryReply, primaryScore, lines
    end

    lines[#lines + 1] = {
        move = primaryMove,
        reply = primaryReply,
        score = primaryNumeric,
        primary = true,
    }
    
    for _, candidate in ipairs(candidates) do
        if token ~= State.AnalysisToken then
            return primaryMove, primaryReply, primaryNumeric, lines
        end

        if candidate ~= primaryMove then
            local reply, score = engineLineScore(fen, candidate, token, childTime)
            local lineScore = tonumber(score)
            if lineScore ~= nil then
                lines[#lines + 1] = {
                    move = candidate,
                    reply = reply,
                    score = lineScore,
                    primary = false,
                }
            end
        end
    end

    if #lines == 1 then
        return primaryMove, primaryReply, primaryNumeric, lines
    end

    table.sort(lines, function(a, b)
        if a.score == b.score then
            return (a.move or "") < (b.move or "")
        end
        return (a.score or -math.huge) > (b.score or -math.huge)
    end)

    local profile = getAIProfile()
    local selected = styleSelectLine(fen, lines, primaryNumeric) or lines[1]

    if profile.AlienGambit == true then
        local alienMove = getAlienGambitPlanMove(fen)
        if alienMove then
            for _, line in ipairs(lines) do
                if line.move == alienMove then
                    local rawDelta = (line.score or primaryNumeric) - primaryNumeric
                    if rawDelta >= -math.max(tonumber(profile.MaxEngineGiveback) or 0) then
                        selected = line
                    end
                    break
                end
            end
        end
    end

    if profile.WillyAlien == true then
        local deepTime = math.max(getSmartVerifyTime(), math.min(2.4, (tonumber(State.SearchTime) or 2.5) * 0.72))
        local bestPolicy = selected
        local bestPolicyScore = -math.huge

        for _, line in ipairs(lines) do
            if token ~= State.AnalysisToken then
                return primaryMove, primaryReply, primaryNumeric, lines
            end

            local raw = tonumber(line.score)
            if raw then
                local delta = raw - primaryNumeric
                if delta >= -math.max(tonumber(profile.MaxEngineGiveback) or 0) then
                    local reply2, score2 = engineLineScore(fen, line.move, token, deepTime)
                    local verified = tonumber(score2) or raw
                    local weird = willyAlienMoveBias(fen, line.move)
                    local value = verified * 0.78 + raw * 0.22 + weird * 16.0

                    if value > bestPolicyScore then
                        bestPolicyScore = value
                        bestPolicy = line
                        bestPolicy.DeepReply = reply2
                        bestPolicy.DeepScore = verified
                    end
                end
            end
        end

        selected = bestPolicy or selected
        if selected.DeepReply then
            selected.reply = selected.DeepReply
        end
        if selected.DeepScore then
            selected.score = selected.DeepScore
        end
    end

    local finalMove = selected.move or primaryMove
    local finalReply = selected.reply or primaryReply
    local finalScore = tonumber(selected.score) or primaryNumeric

    if finalMove ~= primaryMove then
        pcall(setStatus, tostring(State.AIStyle) .. " policy pick • " .. tostring(finalMove))
    end

    if finalMove ~= primaryMove then
        local verifyTime = getSmartVerifyTime()
        local verifyPrimaryReply, verifyPrimaryScore = engineLineScore(fen, primaryMove, token, verifyTime)
        local verifyChosenReply, verifyChosenScore = engineLineScore(fen, finalMove, token, verifyTime)
        local pScore = tonumber(verifyPrimaryScore)
        local cScore = tonumber(verifyChosenScore)

        if token ~= State.AnalysisToken then
            return primaryMove, primaryReply, primaryNumeric, lines
        end

        local safetyFloor = math.max(tonumber(profile.MaxEngineGiveback) or 0, 0.05)
        if pScore and cScore and cScore < pScore - safetyFloor then
            finalMove = primaryMove
            finalReply = verifyPrimaryReply or primaryReply
            finalScore = pScore
            pcall(setStatus, tostring(State.AIStyle) .. " safety fallback • primary line retained")
        else
            finalReply = verifyChosenReply or finalReply
            finalScore = cScore or finalScore
        end
    end

    for _, entry in ipairs(lines) do
        if entry.move == finalMove then
            entry.reply = finalReply or entry.reply
            entry.score = finalScore or entry.score
            break
        end
    end

    return finalMove, finalReply, finalScore, lines
end

