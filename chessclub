local function boardToMatrix(fen)
    local board = string.match(fen or "", "^(%S+)")
    if not board then
        return nil
    end

    local matrix = {}
    for rank = 1, 8 do
        matrix[rank] = {}
        for file = 1, 8 do
            matrix[rank][file] = "."
        end
    end

    local rank = 8
    local file = 1
    for token in board:gmatch("[1-8KQRBNPkqrbnp]") do
        local empty = tonumber(token)
        if empty then
            file += empty
        else
            if rank < 1 or file > 8 then
                return nil
            end
            matrix[rank][file] = token
            file += 1
        end
        if file > 8 then
            rank -= 1
            file = 1
        end
    end

    if rank ~= 1 or file ~= 1 then
        return nil
    end
    return matrix
end
local function squareToCoords(square)
    local file = string.byte(square, 1) - string.byte("a") + 1
    local rank = tonumber(square:sub(2))
    if file < 1 or file > 8 or not rank or rank < 1 or rank > 8 then
        return nil
    end
    return file, rank
end
local function coordsToSquare(file, rank)
    if file < 1 or file > 8 or rank < 1 or rank > 8 then
        return nil
    end
    return string.char(string.byte("a") + file - 1) .. tostring(rank)
end

local function serializeBoard(matrix)
    local rows = {}
    for rank = 8, 1, -1 do
        local row = ""
        local empty = 0
        for file = 1, 8 do
            local piece = matrix[rank][file]
            if piece == "." then
                empty += 1
            else
                if empty > 0 then
                    row ..= tostring(empty)
                    empty = 0
                end
                row ..= piece
            end
        end
        if empty > 0 then
            row ..= tostring(empty)
        end
        rows[#rows + 1] = row
    end
    return table.concat(rows, "/")
end

local function applyUCIMove(fen, move)
    if type(fen) ~= "string" or type(move) ~= "string" then
        return nil
    end
    local from, to, promo = move:match("^([a-h][1-8])([a-h][1-8])([qrbn]?)$")
    if not from or not to then
        return nil
    end
    local fields = {}
    for part in fen:gmatch("%S+") do
        fields[#fields + 1] = part
    end
    if #fields < 4 then
        return nil
    end
    local active = fields[2] == "b" and "b" or "w"
    local castling = fields[3] or "-"
    local ep = fields[4] or "-"
    local halfmove = tonumber(fields[5]) or 0
    local fullmove = tonumber(fields[6]) or 1

    local matrix = boardToMatrix(fen)
    if not matrix then
        return nil
    end

    local ff, fr = squareToCoords(from)
    local tf, tr = squareToCoords(to)
    if not ff or not tf then
        return nil
    end

    local piece = matrix[fr][ff]
    if piece == "." then
        return nil
    end

    local destination = matrix[tr][tf]
    local isWhite = piece:match("%u") ~= nil
    local isPawn = piece:lower() == "p"
    local isKing = piece:lower() == "k"
    local isRook = piece:lower() == "r"
    local isCapture = destination ~= "."

    if isPawn and destination == "." and ff ~= tf and ep ~= "-" and ep == to then
        local capturedRank = isWhite and (tr - 1) or (tr + 1)
        if capturedRank >= 1 and capturedRank <= 8 and matrix[capturedRank][tf] ~= "." then
            matrix[capturedRank][tf] = "."
            isCapture = true
        end
    end

    matrix[fr][ff] = "."
    matrix[tr][tf] = piece

    if isKing and math.abs(tf - ff) == 2 then
        if tf > ff then
            matrix[fr][8] = "."
            matrix[fr][6] = isWhite and "R" or "r"
        else
            matrix[fr][1] = "."
            matrix[fr][4] = isWhite and "R" or "r"
        end
    end

    if isPawn and tr == (isWhite and 8 or 1) and promo ~= "" then
        matrix[tr][tf] = isWhite and promo:upper() or promo:lower()
    end

    local rights = castling == "-" and "" or castling
    local function removeRight(ch)
        rights = rights:gsub(ch, "")
    end

    if isKing then
        if isWhite then
            removeRight("K")
            removeRight("Q")
        else
            removeRight("k")
            removeRight("q")
        end
    end

    if isRook then
        if from == "a1" then removeRight("Q") end
        if from == "h1" then removeRight("K") end
        if from == "a8" then removeRight("q") end
        if from == "h8" then removeRight("k") end
    end

    if destination == "R" and to == "a1" then removeRight("Q") end
    if destination == "R" and to == "h1" then removeRight("K") end
    if destination == "r" and to == "a8" then removeRight("q") end
    if destination == "r" and to == "h8" then removeRight("k") end

    local newEp = "-"
    if isPawn and math.abs(tr - fr) == 2 then
        newEp = coordsToSquare(ff, (tr + fr) // 2) or "-"
    end

    if isPawn or isCapture then
        halfmove = 0
    else
        halfmove += 1
    end

    if active == "b" then
        fullmove += 1
    end

    local nextActive = active == "w" and "b" or "w"
    if rights == "" then
        rights = "-"
    end

    return serializeBoard(matrix)
        .. " " .. nextActive
        .. " " .. rights
        .. " " .. newEp
        .. " " .. tostring(halfmove)
        .. " " .. tostring(fullmove)

end

