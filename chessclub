    part.Position = UDim2.fromScale(rect.x, rect.y)
    part.Size = UDim2.fromScale(rect.w, rect.h)
    return true

end

local function buildMovePath(from, to)

    local ff, fr = squareIndex(from)
    local tf, tr = squareIndex(to)

    if ff == nil or tf == nil then
        return {from, to}
    end

    local df = tf - ff
    local dr = tr - fr

    local stepF = 0
    local stepR = 0

    if df == 0 and dr ~= 0 then
        stepR = dr > 0 and 1 or -1
    elseif dr == 0 and df ~= 0 then
        stepF = df > 0 and 1 or -1
    elseif math.abs(df) == math.abs(dr) then
        stepF = df > 0 and 1 or -1
        stepR = dr > 0 and 1 or -1
    else
        return {from, to}
    end

    local path = {from}
    local f, r = ff, fr

    while f ~= tf or r ~= tr do
        f += stepF
        r += stepR
        if f < 0 or f > 7 or r < 1 or r > 8 then
            return {from, to}
        end

        local square = string.char(string.byte("a") + f) .. tostring(r)
        table.insert(path, square)

        if #path > 8 then
            break
        end
    end

    if path[#path] ~= to then
        table.insert(path, to)
    end

    return path

end

local function startBestMovePulse(from, to)

    State.PulseToken += 1
    local token = State.PulseToken
    local board = State.OverlayBoard

    if not board then
        return
    end

    hidePulseParts()

    local path = buildMovePath(from, to)
    local rippleColor, rippleGlow = getTeamRippleColors(from)

    task.spawn(function()
        for index, square in ipairs(path) do
            if token ~= State.PulseToken or not State.ShowBoardOverlay or not State.HighlightBestMove then
                return
            end

            local part = createPulsePart(index, rippleColor, rippleGlow)
            if not movePulsePart(part, board, square) then
                return
            end

            part.BackgroundColor3 = rippleColor
            part.Visible = true
            part.BackgroundTransparency = 1

            local stroke = part:FindFirstChildOfClass("UIStroke")
            if stroke then
                stroke.Color = rippleGlow
            end

            local inTween = TweenService:Create(
                part,
                TweenInfo.new(0.045, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {BackgroundTransparency = 0.45}
            )
            inTween:Play()
            inTween.Completed:Wait()

            if token ~= State.PulseToken then
                return
            end

            local outTween = TweenService:Create(
                part,
                TweenInfo.new(0.045, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                {BackgroundTransparency = 0.88}
            )
            outTween:Play()
            outTween.Completed:Wait()

            if token ~= State.PulseToken then
                return
            end
        end
    end)

end

