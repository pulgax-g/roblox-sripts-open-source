    local ff, fr = squareToCoords(from)
    local tf, tr = squareToCoords(to)
    if not ff or not tf then
        return 0
    end

    local piece = matrix[fr][ff]
    local target = matrix[tr][tf]
    local lower = piece and piece:lower() or ""
    local targetLower = target and target ~= "." and target:lower() or nil
    local bias = 0

