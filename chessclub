local function getSquareGuiMap(board)

    local map = {}

    if not board then
        return map
    end

    local boardSize = board.AbsoluteSize
    local target = math.max(12, math.min(boardSize.X, boardSize.Y) / 8)

    for _, obj in ipairs(board:GetDescendants()) do
        if obj:IsA("GuiObject") and obj.Visible then
            local square = normalizeSquareName(obj.Name)

            if not square and (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then
                square = normalizeSquareName(obj.Text)
            end

            if square then
                local size = obj.AbsoluteSize
                local ratio = size.X / math.max(size.Y, 1)
                local squarePenalty = math.abs(1 - ratio)
                local sizePenalty = math.abs(size.X - target) + math.abs(size.Y - target)
                local area = size.X * size.Y

                if size.X > 6 and size.Y > 6 and squarePenalty < 0.45 then
                    local score = squarePenalty * target + sizePenalty
                    local current = map[square]
                    if not current or score < current.Score then
                        map[square] = {
                            Object = obj,
                            Area = area,
                            Score = score,
                        }
                    end
                end
            end
        end
    end

    return map

end

