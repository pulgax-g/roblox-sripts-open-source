        .. tostring(State.ShowLastMove)
        .. "|"
        .. tostring(State.HighlightBestMove)

    if signature == State.BoardSignature then
        return
    end

    State.BoardSignature = signature

    if State.BestMove and State.HighlightBestMove then
        hideHighlight("LastFrom")
        hideHighlight("LastTo")
        State.PulseToken += 1
        hidePulseParts()
        hideHighlight("BestFrom")
        hideHighlight("BestTo")
        clearBestMoveTileMarkers()
        drawBestMoveExact(State.BestMove)
        return
    end

    if State.ShowLastMove and State.LastMove then
        local from, to = parseUCI(State.LastMove)
        if from and to then
            setHighlight("LastFrom", from, Color3.fromRGB(96, 154, 255), 0.87)
            setHighlight("LastTo", to, Color3.fromRGB(96, 154, 255), 0.83)
        else
            hideHighlight("LastFrom")
            hideHighlight("LastTo")
        end
    else
        hideHighlight("LastFrom")
        hideHighlight("LastTo")
    end

    if State.HighlightBestMove and State.BestMove then
        local from, to = parseUCI(State.BestMove)
        if from and to then
            drawBestMove(from, to)
        else
            hideHighlight("BestFrom")
            hideHighlight("BestTo")
        end
    else
        State.PulseToken += 1
        hidePulseParts()
        hideHighlight("BestFrom")
        hideHighlight("BestTo")
    end

end

