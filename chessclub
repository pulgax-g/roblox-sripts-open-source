local function fenPieceAt(fen, square)

    if type(fen) ~= "string" or type(square) ~= "string" then
        return nil
    end

    local placement = fen:match("^(%S+)")
    if not placement then
        return nil
    end

    local file = string.byte(square, 1) - string.byte("a") + 1
    local rank = tonumber(square:sub(2))
    if file < 1 or file > 8 or not rank or rank < 1 or rank > 8 then
        return nil
    end

    local rows = string.split(placement, "/")
    local row = rows[9 - rank]
    if not row then
        return nil
    end

    local col = 0
    for i = 1, #row do
        local ch = row:sub(i, i)
        local digit = tonumber(ch)
        if digit then
            col += digit
        else
            col += 1
            if col == file then
                return ch
            end
        end
    end
    return nil
end

