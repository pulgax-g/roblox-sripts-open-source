function State.RefreshAmIBanned()

    if not State.AmIBanned then
        destroyAmIBannedGui()
        return nil, "Disabled"
    end

    if State.AmIBannedGui and State.AmIBannedGui.Parent == nil then
        State.AmIBannedGui = nil
    end

    local banned, reason = getClientVisibleBanState()

    if banned ~= true then
        destroyAmIBannedGui()
        return banned, reason
    end

    if State.AmIBannedGui and State.AmIBannedGui.Parent then
        return true, reason
    end

    local marker, sourceBoard, head = findLocalBannedMarker(true)
    if marker and head then
        createAmIBannedGui(marker, sourceBoard, head)
        return true, reason
    end

    return true, reason

end

local function startAmIBannedWatcher()

    State.AmIBannedToken = (State.AmIBannedToken or 0) + 1
    local token = State.AmIBannedToken

    task.spawn(function()
        while State.AmIBanned and token == State.AmIBannedToken do
            pcall(State.RefreshAmIBanned)
            task.wait(0.5)
        end
    end)

end

