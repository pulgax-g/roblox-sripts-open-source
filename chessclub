local function getSquareVisualRect(board, square)

    if not board or not square then
        return nil
    end

    local tile = board:FindFirstChild(square)
    if not tile or not tile:IsA("GuiObject") or not tile.Visible then
        return nil
    end

    local boardPos = board.AbsolutePosition
    local boardSize = board.AbsoluteSize
    local tilePos = tile.AbsolutePosition
    local tileSize = tile.AbsoluteSize

    if boardSize.X <= 0 or boardSize.Y <= 0 or tileSize.X <= 0 or tileSize.Y <= 0 then
        return nil
    end

    return {
        x = (tilePos.X - boardPos.X) / boardSize.X,
        y = (tilePos.Y - boardPos.Y) / boardSize.Y,
        w = tileSize.X / boardSize.X,
        h = tileSize.Y / boardSize.Y,
    }

end

