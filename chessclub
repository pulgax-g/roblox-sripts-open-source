local function pulseExactBestMove(from, to, suppliedToken)
    State.RippleToken = suppliedToken or (State.RippleToken + 1)
    local token = State.RippleToken
    State.RippleObjects[token] = {}

    local board = getRippleBoard()
    if not board then
        return
    end

    local fromTile = getRippleTile(board, from)
    local toTile = getRippleTile(board, to)
    if not fromTile or not toTile then
        return
    end

    local side = getRipplePieceSide(from) or State.AnalysisSide or localSide()
    local path = buildExactMovePath(from, to)

    task.spawn(function()
        for index, square in ipairs(path) do
            if token ~= State.RippleToken
                or not State.HighlightBestMove
                or not State.BestMove then
                return
            end

            local liveBoard = getRippleBoard()
            local tile = getRippleTile(liveBoard, square)
            if not tile then
                return
            end

            local kind = index == #path and "to" or (index == 1 and "from" or "path")
            local rippleColor
            local rippleGlow

            if kind == "to" then
                rippleColor, rippleGlow = getRippleColorsForTile("to", side)
            else
                rippleColor, rippleGlow = getRippleColorsForTile("from", side)
            end

            local ripple = createStandaloneRipple(tile, kind, rippleColor, rippleGlow, token)
            if not ripple then
                return
            end

            task.wait(kind == "to" and 0.06 or 0.035)
        end

        task.wait(0.20)
        if State.RippleObjects[token] then
            State.RippleObjects[token] = nil
        end
    end)
end

local function drawBestMoveExact(move)

    clearBestMoveTileMarkers()

    if type(move) ~= "string" then
        return false
    end

    local from, to = parseUCI(move)
    if not from or not to then
        return false
    end

    local gameClient = getLiveChessGameClient()
    if not gameClient or type(gameClient.Ui2D) ~= "table" then
        return false
    end

    local ref = gameClient.Ui2D.Ref
    local board = ref and ref:FindFirstChild("Board")
    if not board then
        return false
    end

    local fromMarker = addBestMoveTileMarker(from, "from")
    local destinationMarker = addBestMoveTileMarker(to, "to")

    if not fromMarker or not destinationMarker then
        clearBestMoveTileMarkers()
        return false
    end

    local token = State.PulseToken
    animateMoveMarker(fromMarker, false, token)
    animateMoveMarker(destinationMarker, true, token)
    pulseExactBestMove(from, to, token)

    return true

end

local function isFENString(value)

    if type(value) ~= "string" then
        return false
    end

    return value:match("^[^%s]+ [wb] [^%s]+ [^%s]+") ~= nil

end

