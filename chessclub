local function guiTreeVisible(gui)

    if not gui or not gui:IsA("GuiObject") then
        return false
    end

    local current = gui

    while current do
        if current:IsA("GuiObject") and not current.Visible then
            return false
        end

        if current:IsA("BillboardGui") and not current.Enabled then
            return false
        end

        current = current.Parent

        if current == game then
            break
        end
    end

    return true

end

local function findLocalBannedMarker(allowHidden)

    local character = LocalPlayer.Character
    if not character then
        return nil, nil, nil
    end

    local head = character:FindFirstChild("Head")
    if not head then
        return nil, nil, nil
    end

    local function findMarker(root)
        if not root then
            return nil
        end

        local marker = root:FindFirstChild("Banned", true)
        if marker and marker:IsA("GuiObject") then
            if allowHidden or marker.Visible then
                return marker
            end
        end

        return nil
    end

    local marker = findMarker(head:FindFirstChild("Headboard"))
        or findMarker(head)

    if marker then
        return marker, marker:FindFirstAncestorOfClass("BillboardGui"), head
    end

    return nil, nil, head

end

local function normalizeBanValue(value)

    if typeof(value) == "boolean" then
        return value
    end

    if typeof(value) == "number" then
        return value ~= 0
    end

    if typeof(value) == "string" then
        local v = value:lower():gsub("%s+", "")

        if v == "true"
            or v == "1"
            or v == "yes"
            or v == "banned"
            or v == "ratingbanned"
            or v == "ratingban" then
            return true
        end

        if v == "false"
            or v == "0"
            or v == "no"
            or v == "unbanned"
            or v == "notbanned" then
            return false
        end
    end

    return nil

end

local function looksLikeBanName(name)

    local n = tostring(name or ""):lower():gsub("[%s_%-]", "")

    return n == "banned"
        or n == "ban"
        or n == "ratingban"
        or n == "ratingbanned"
        or n == "isbanned"
        or n == "isratingbanned"

end

local function findExplicitBanState(root)

    if not root then
        return nil
    end

    local explicitFalse = false

    for name, value in pairs(root:GetAttributes()) do
        if looksLikeBanName(name) then
            local state = normalizeBanValue(value)
            if state == true then
                return true
            elseif state == false then
                explicitFalse = true
            end
        end
    end

    for _, object in ipairs(root:GetDescendants()) do
        if looksLikeBanName(object.Name) then
            if object:IsA("BoolValue") then
                if object.Value == true then
                    return true
                end
                explicitFalse = true
            elseif object:IsA("StringValue")
                or object:IsA("IntValue")
                or object:IsA("NumberValue") then
                local state = normalizeBanValue(object.Value)
                if state == true then
                    return true
                elseif state == false then
                    explicitFalse = true
                end
            elseif object:IsA("GuiObject") then
                if guiTreeVisible(object) then
                    return true
                end
            end
        end
    end

    if explicitFalse then
        return false
    end

    return nil

end

local function getClientVisibleBanState()

    local character = LocalPlayer.Character
    local playerState = findExplicitBanState(LocalPlayer)

    if playerState == true then
        return true, "Player state"
    end

    if character then
        local characterState = findExplicitBanState(character)
        if characterState == true then
            return true, "Character state"
        end
    end

    local marker = select(1, findLocalBannedMarker())
    if marker then
        return true, "Visible Banned marker"
    end

    if playerState == false then
        return false, "Player state"
    end

    if character then
        local characterState = findExplicitBanState(character)
        if characterState == false then
            return false, "Character state"
        end
    end

    return nil, "No authoritative client-side ban state"

end

