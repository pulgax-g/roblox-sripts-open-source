local function setFENSide(fen, side)

    if type(fen) ~= "string" or (side ~= "w" and side ~= "b") then
        return fen
    end

    local fields = {}
    for field in fen:gmatch("%S+") do
        fields[#fields + 1] = field
    end

    if #fields < 2 then
        return fen
    end

    fields[2] = side

    return table.concat(fields, " ")

end

local function getLiveTurnSide(gameClient, mine)

    if gameClient and type(gameClient.WhiteToPlay) == "boolean" then
        return gameClient.WhiteToPlay and "w" or "b"
    end

    local fenSide = activeColor()
    if fenSide == "w" or fenSide == "b" then
        return fenSide
    end

    return mine

end

function State.TryMove(forceAnalysis)

    if not State.ReadAccepted then
        return
    end

    local liveClient = getLiveChessGameClient()

    if liveClient and type(liveClient.AmIWhite) == "boolean" then
        State.LocalSideOverride = liveClient.AmIWhite and "w" or "b"
    end

    if not State.Enabled or State.Running or not State.FEN or not State.GameID then
        return
    end

    if not forceAnalysis and not State.AutoAnalyze and not State.AutoPlay then
        return
    end

    if liveClient and type(liveClient.FEN) == "string" and liveClient.FEN ~= "" then
        State.FEN = liveClient.FEN
    end

    local mine = liveClient and type(liveClient.AmIWhite) == "boolean" and (liveClient.AmIWhite and "w" or "b") or localSide()
    local turnSide = getLiveTurnSide(liveClient, mine)

    if mine ~= "w" and mine ~= "b" then
        updateStatus()
        return
    end

    if turnSide ~= mine then
        updateStatus()
        return
    end

    local fen = setFENSide(State.FEN, turnSide)
    local token = State.AnalysisToken + 1
    State.AnalysisToken = token
    State.Running = true
    State.BestMove = nil
    State.BestScore = nil
    State.AnalysisSide = turnSide
    State.AnalysisFEN = fen
    State.SecondChoiceMove = nil
    State.SecondChoiceReply = nil
    State.SecondChoiceScore = nil
    State.SecondChoiceLines = {}
    State.NovaReaction = nil

    if State.AIStyle == "Willy Alien" then
        pcall(setStatus, "Willy Alien • deep search • unusual move scan • " .. tostring(State.SearchTime) .. "s")
    elseif State.AIStyle == "Alien Gambit" then
        pcall(setStatus, "Alien Gambit • Caro-Kann attack • " .. tostring(State.SearchTime) .. "s")
    else
        pcall(setStatus, "Analyzing " .. tostring(State.AIStyle or "Balanced") .. " • " .. tostring(State.SearchTime) .. "s")
    end
    pcall(updateInfo)
    pcall(clearHighlights)
    clearBestMoveTileMarkers()

    task.delay(math.max(8, State.SearchTime * 6 + 2), function()
        if State.Running and State.AnalysisToken == token and State.AnalysisFEN == fen then
            State.Running = false
            State.AnalysisToken += 1
            State.BestMove = nil
            State.BestScore = nil
            pcall(setStatus, "Analysis timed out • retrying is safe")
            pcall(updateInfo)
            pcall(refreshBoardOverlay)
        end
    end)

    task.spawn(function()
        local okTask, taskError = xpcall(function()
            local move
            local score

            if ActiveAPI and ActiveAPI.GetBestMoveFromFEN then
                local engineDone = false
                local engineMove = nil
                local engineScore = nil
                task.spawn(function()
                    local ok, a, b, c = pcall(function()
                        return ActiveAPI:GetBestMoveFromFEN(fen, State.SearchTime)
                    end)
                    if ok then
                        engineMove = a
                        engineScore = b
                        State.NovaReaction = c
                    end
                    engineDone = true
                end)

                local deadline = os.clock() + math.max(4, State.SearchTime + 2.5)
                while not engineDone and os.clock() < deadline do
                    if token ~= State.AnalysisToken then
                        return
                    end
                    task.wait(0.05)
                end

                if engineDone then
                    move = engineMove
                    score = engineScore
                end
            end

            if token ~= State.AnalysisToken then
                State.Running = false
                return
            end

            if not move then
                move = fallbackMove(fen)
            end

            if State.AIStyle == "Alien Gambit" then
                local alienPlanMove = getAlienGambitPlanMove(fen)
                if alienPlanMove then
                    move = alienPlanMove
                    score = nil
                    pcall(setStatus, "Alien Gambit plan • " .. tostring(move))
                end
            end

            local moveFrom = type(move) == "string" and move:sub(1, 2) or nil
            local sourcePiece = moveFrom and fenPieceAt(fen, moveFrom) or nil
            local sourceSide = sourcePiece and (sourcePiece:match("%u") and "w" or "b") or nil

            if sourceSide ~= turnSide then
                State.Running = false
                State.BestMove = nil
                State.BestScore = nil
                pcall(clearBestMoveTileMarkers)
                pcall(setStatus, "AI returned opponent move • rejected")
                pcall(updateInfo)
                pcall(refreshBoardOverlay)
                return
            end

            if token ~= State.AnalysisToken then
                State.Running = false
                return
            end

            local selectedMove = move
            local choiceReply
            local choiceScore
            local choiceLines = {}
            local externalEngineOwnsSearch = ActiveAPIName == "Zyrqon Nova"
                or ActiveAPIName == "Lith"
                or ActiveAPIName == "Null.Mini"
                or ActiveAPIName == "Muse"

            if (State.SmartAnalysis or State.SecondChoices or State.AIStyle ~= "Balanced") and move and not externalEngineOwnsSearch then
                if State.SmartAnalysis or State.AIStyle ~= "Balanced" then
                    pcall(setStatus, "Smart analysis • checking alternatives...")
                else
                    pcall(setStatus, "Thinking through second choices...")
                end
                selectedMove, choiceReply, choiceScore, choiceLines = smartChoicePlan(fen, move, token)
            end

            if token ~= State.AnalysisToken then
                State.Running = false
                return
            end

            local finalMove = selectedMove or move
            local finalFrom = type(finalMove) == "string" and finalMove:sub(1, 2) or nil
            local finalPiece = finalFrom and fenPieceAt(fen, finalFrom) or nil
            local finalSide = finalPiece and (finalPiece:match("%u") and "w" or "b") or nil

            if finalSide ~= turnSide then
                State.Running = false
                State.BestMove = nil
                State.BestScore = nil
                pcall(clearBestMoveTileMarkers)
                pcall(setStatus, "Best move validation failed")
                pcall(updateInfo)
                pcall(refreshBoardOverlay)
                return
            end

            State.BestMove = finalMove
            State.BestScore = finalMove == move and score or (choiceScore or score)

            if ActiveAPIName == "Zyrqon Nova"
                and State.NovaPersonalityEnabled
                and type(State.NovaReaction) == "table"
                and State.NovaReaction.notify == true
                and State.NovaNoticeToken ~= token then
                State.NovaNoticeToken = token
                local reactionTag = tostring(State.NovaReaction.tag or "NOVA")
                local reactionMessage = tostring(State.NovaReaction.message or "Nova found something interesting.")
                local reactionIcon = tostring(State.NovaReaction.icon or "sparkles")
                pcall(Notify, "Zyrqon Nova • " .. reactionTag, reactionMessage, reactionIcon, 4)
            end
            State.AnalysisSide = turnSide
            State.AnalysisFEN = fen
            State.SecondChoiceMove = finalMove
            State.SecondChoiceReply = choiceReply
            State.SecondChoiceScore = choiceScore
            State.SecondChoiceLines = choiceLines or {}

            local liveNow = getLiveChessGameClient()
            if liveNow and type(liveNow.FEN) == "string" and liveNow.FEN ~= "" then
                State.FEN = liveNow.FEN
            end

            local nowSide = getLiveTurnSide(liveNow, mine)
            if nowSide ~= mine then
                State.Running = false
                pcall(updateStatus)
                pcall(updateInfo)
                pcall(refreshBoardOverlay)
                return
            end

            pcall(updateInfo)
            pcall(refreshBoardOverlay)
            if State.Enabled and State.AutoPlay and finalMove then
                local submitOK = false
                local submitWorked, submitResult = pcall(function()
                    return State.SubmitMove(finalMove)
                end)
                submitOK = submitWorked and submitResult == true

                if submitOK then
                    if State.SecondChoices and choiceReply then
                        pcall(setStatus, "Played " .. finalMove .. " • expecting " .. choiceReply)
                    else
                        pcall(setStatus, "Played " .. finalMove)
                    end
                else
                    pcall(setStatus, "Move found • submit failed")
                end
            else
                local detail = finalMove or "—"
                if State.SecondChoices and choiceReply then
                    detail ..= " • reply " .. choiceReply
                end
                pcall(setStatus, "Best move ready • " .. detail)
            end
        end, function(err)
            return tostring(err)
        end)

        State.Running = false

        if not okTask then
            State.BestMove = nil
            State.BestScore = nil
            pcall(setStatus, "Analysis error • retrying is safe")
        end

        pcall(updateInfo)
        pcall(refreshBoardOverlay)
    end)
end

function State.SubmitMove(move)
    if not State.GameID or not move then
        return false
    end
    if not move:match("^[a-h][1-8][a-h][1-8][qrbn]?$") then
        return false
    end
    local ChessRemotes = getChessRemotes()
    if not ChessRemotes then
        return false
    end

    local ok, remotes = pcall(function()
        return ChessRemotes(State.GameID)
    end)

    if not ok or not remotes or not remotes.SubmitMove then
        return false
    end

    local activeAtSend = State.FEN
    remotes.SubmitMove:FireServer(move)
    State.LastMove = move
    State.LastSentFEN = activeAtSend
    State.MoveNumber += 1
    refreshBoardOverlay()
    return true
end

local function attachGame(gameData)
    if type(gameData) ~= "table" then
        return
    end
    if not gameData.gameID or not gameData.fen then
        return
    end
    disconnectList(State.GameConns)
    State.GameID = gameData.gameID or gameData.GameID
    State.FEN = gameData.fen or gameData.FEN
    State.WhiteName = gameData.whiteName or gameData.WhiteName or gameData.whitePlayer or gameData.WhitePlayer or gameData.whiteUser or gameData.WhiteUser or gameData.whiteRef or gameData.WhiteRef
    State.BlackName = gameData.blackName or gameData.BlackName or gameData.blackPlayer or gameData.BlackPlayer or gameData.blackUser or gameData.BlackUser or gameData.blackRef or gameData.BlackRef
    State.LocalSideOverride = resolveLocalSide(gameData)
    State.BoardOrientation = nil
    State.Running = false
    State.MoveNumber = 0
    State.LastMove = nil
    State.BestMove = nil
    State.BestScore = nil
    State.AnalysisToken += 1
    local ChessRemotes = getChessRemotes()
    if not ChessRemotes then
        setStatus("Chess remotes unavailable.")
        return
    end
    local ok, remotes = pcall(function()
        return ChessRemotes(State.GameID)
    end)
    if not ok or not remotes then
        setStatus("Couldn't attach to game.")
        return
    end
    if remotes.MoveMade then
        table.insert(State.GameConns, remotes.MoveMade.OnClientEvent:Connect(function(newFEN)
                        clearBestMoveTileMarkers()
            State.FEN = newFEN
            State.Running = false
            State.BestMove = nil
            State.BestScore = nil
            State.AnalysisSide = nil
            State.AnalysisFEN = nil
            State.SecondChoiceMove = nil
            State.SecondChoiceReply = nil
            State.SecondChoiceScore = nil
            State.SecondChoiceLines = {}
            State.AnalysisToken += 1
            updateStatus()
            updateInfo()
            refreshBoardOverlay()
            if State.AutoAnalyze or State.AutoPlay then
                task.defer(function()
                    State.TryMove(false)
                end)
            end
        end))
    end
    if remotes.GameEnded then
        table.insert(State.GameConns, remotes.GameEnded.OnClientEvent:Connect(function()
            State.GameID = nil
                        clearBestMoveTileMarkers()
            State.FEN = nil
            State.WhiteName = nil
            State.BlackName = nil
            State.LocalSideOverride = nil
            State.BoardOrientation = nil
            State.Running = false
            State.BestMove = nil
            State.BestScore = nil
            State.AnalysisSide = nil
            State.AnalysisFEN = nil
            State.SecondChoiceMove = nil
            State.SecondChoiceReply = nil
            State.SecondChoiceScore = nil
            State.SecondChoiceLines = {}
            State.AnalysisToken += 1
            updateStatus()
            updateInfo()
            refreshBoardOverlay()
        end))
    end

    updateStatus()
    updateInfo()
    refreshBoardOverlay()
    if State.AutoAnalyze or State.AutoPlay then
        task.defer(function()
            State.TryMove(false)
        end)
    end
end
