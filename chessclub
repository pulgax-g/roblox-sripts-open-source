local function attachCurrentGame()
    local playerScripts = LocalPlayer:FindFirstChildOfClass("PlayerScripts")
    if not playerScripts then
        return
    end
    local proxyModule = findDescendant(playerScripts, "ChessProxyService")
    if not proxyModule or not proxyModule:IsA("ModuleScript") then
        return
    end
    local ok, proxy = pcall(require, proxyModule)
    if not ok or type(proxy) ~= "table" then
        return
    end
    local gameClient = proxy.ChessGame
    if type(gameClient) == "table" and (gameClient.GameID or gameClient.gameID) and (gameClient.FEN or gameClient.fen) then
        if type(gameClient.AmIWhite) == "boolean" then
