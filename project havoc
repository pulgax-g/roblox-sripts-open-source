local function CreateESP(player)
    if ESPObjects[player] then return end
    local obj = {lines = {}, name = nil, health = nil, distance = nil, tracer = nil, healthbar = nil, healthbarBG = nil}
    for i = 1, 12 do local l = Drawing.new("Line"); l.Thickness = 1.2; l.Color = Colors.accent; l.Visible = false; obj.lines[i] = l end
    obj.name = Drawing.new("Text"); obj.name.Size = 14; obj.name.Center = true; obj.name.Outline = true; obj.name.Color = Colors.white; obj.name.Visible = false
    obj.health = Drawing.new("Text"); obj.health.Size = 13; obj.health.Center = false; obj.health.Outline = true; obj.health.Color = Colors.green; obj.health.Visible = false
    obj.distance = Drawing.new("Text"); obj.distance.Size = 13; obj.distance.Center = true; obj.distance.Outline = true; obj.distance.Color = Colors.yellow; obj.distance.Visible = false
    obj.tracer = Drawing.new("Line"); obj.tracer.Thickness = 1.2; obj.tracer.Color = Colors.accent; obj.tracer.Visible = false
    obj.healthbarBG = Drawing.new("Line"); obj.healthbarBG.Thickness = 3; obj.healthbarBG.Color = Color3.fromRGB(40,40,40); obj.healthbarBG.Visible = false
    obj.healthbar = Drawing.new("Line"); obj.healthbar.Thickness = 2; obj.healthbar.Color = Colors.green; obj.healthbar.Visible = false
    ESPObjects[player] = obj
end

local function ClearESP(player)
    local obj = ESPObjects[player]; if not obj then return end
    for _, l in ipairs(obj.lines) do pcall(function() l:Remove() end) end
    for _, k in ipairs({"name","health","distance","tracer","healthbar","healthbarBG"}) do if obj[k] then pcall(function() obj[k]:Remove() end) end end
    ESPObjects[player] = nil
end

local function UpdateESP(player)
    local obj = ESPObjects[player]; if not obj then return end
    local function Hide()
        for _, l in ipairs(obj.lines) do l.Visible = false end
        obj.name.Visible = false; obj.health.Visible = false; obj.distance.Visible = false
        obj.tracer.Visible = false; obj.healthbar.Visible = false; obj.healthbarBG.Visible = false
    end
    if not Config.Enabled or not Config.ESPEnabled or player == LocalPlayer or not IsAlive(player) or IsTeammate(player) then Hide(); return end

    -- Usar hitboxes del workspace para ESP
    local espCenter = GetESPCenter(player)
    local headHB = GetPlayerHitboxes(player) -- headHB, bodyHB
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if not espCenter or not hum then Hide(); return end

    local dist = (espCenter.Position - Camera.CFrame.Position).Magnitude
    if dist > Config.ESPMaxDistance then Hide(); return end

    local headPart = headHB or (char and char:FindFirstChild("Head"))
    if Config.ESPVisibleCheck and headPart and not IsVisible(headPart) then Hide(); return end

    local vis = headPart and IsVisible(headPart)
    local bc = vis and Colors.green or Colors.red

    -- Calcular esquinas de la caja 3D
    local cf, hX, hY, hZ

    if espCenter:IsA("BasePart") then
        -- Usar el CFrame y Size real de la hitbox
        cf = espCenter.CFrame
        hX = espCenter.Size.X / 2
        hY = espCenter.Size.Y / 2
        hZ = espCenter.Size.Z / 2
        -- Asegurar tamaño mínimo visible
        if hX < 0.5 then hX = 1.2 end
        if hY < 1.0 then hY = 2.5 end
        if hZ < 0.5 then hZ = 1.0 end
    else
        -- Fallback: usar posición con tamaño estándar
        cf = CFrame.new(espCenter.Position)
        hY = hum.RigType == Enum.HumanoidRigType.R15 and 2.75 or 2.5
        hX = 1.2; hZ = 1.0
    end

    local c3 = {
        cf*CFrame.new(-hX,hY,-hZ), cf*CFrame.new(hX,hY,-hZ), cf*CFrame.new(hX,hY,hZ), cf*CFrame.new(-hX,hY,hZ),
        cf*CFrame.new(-hX,-hY,-hZ), cf*CFrame.new(hX,-hY,-hZ), cf*CFrame.new(hX,-hY,hZ), cf*CFrame.new(-hX,-hY,hZ),
    }
    local c2 = {}; local ok = true
    for i, c in ipairs(c3) do local sp, on = Camera:WorldToViewportPoint(c.Position); if not on then ok = false; break end; c2[i] = Vector2.new(sp.X, sp.Y) end
    if not ok then Hide(); return end

    local edges = {{1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8}}
    if Config.ESPBoxes then
        for i, e in ipairs(edges) do obj.lines[i].From = c2[e[1]]; obj.lines[i].To = c2[e[2]]; obj.lines[i].Color = bc; obj.lines[i].Visible = true end
    else for _, l in ipairs(obj.lines) do l.Visible = false end end

    local mnX, mnY, mxX, mxY = math.huge, math.huge, -math.huge, -math.huge
    for _, c in ipairs(c2) do if c.X<mnX then mnX=c.X end; if c.Y<mnY then mnY=c.Y end; if c.X>mxX then mxX=c.X end; if c.Y>mxY then mxY=c.Y end end

    if Config.ESPNames then obj.name.Text = player.DisplayName; obj.name.Position = Vector2.new((mnX+mxX)/2, mnY-18); obj.name.Visible = true else obj.name.Visible = false end
    if Config.ESPDistance then obj.distance.Text = math.floor(dist).."m"; obj.distance.Position = Vector2.new((mnX+mxX)/2, mxY+3); obj.distance.Visible = true else obj.distance.Visible = false end
    if Config.ESPHealth then
        local hp = math.clamp(hum.Health/hum.MaxHealth,0,1); local bH = mxY-mnY; local bX = mnX-6
        obj.healthbarBG.From = Vector2.new(bX,mnY); obj.healthbarBG.To = Vector2.new(bX,mxY); obj.healthbarBG.Visible = true
        obj.healthbar.From = Vector2.new(bX,mxY); obj.healthbar.To = Vector2.new(bX,mxY-bH*hp)
        obj.healthbar.Color = Color3.fromRGB(255*(1-hp),255*hp,50); obj.healthbar.Visible = true
        obj.health.Text = math.floor(hum.Health).."hp"; obj.health.Position = Vector2.new(mxX+4,mnY)
        obj.health.Color = Color3.fromRGB(255*(1-hp),255*hp,50); obj.health.Visible = true
    else obj.health.Visible = false; obj.healthbar.Visible = false; obj.healthbarBG.Visible = false end
    if Config.ESPTracers then
        local vps = Camera.ViewportSize
        local ts = Config.TracerOrigin=="Top" and Vector2.new(vps.X/2,0) or Config.TracerOrigin=="Center" and Vector2.new(vps.X/2,vps.Y/2) or Vector2.new(vps.X/2,vps.Y)
        obj.tracer.From = ts; obj.tracer.To = Vector2.new((mnX+mxX)/2,mxY); obj.tracer.Color = bc; obj.tracer.Visible = true
    else obj.tracer.Visible = false end
end

