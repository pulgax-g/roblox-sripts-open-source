-- ANTI-AIM
-- ═══════════════════════════════════════
local aaAngle = 0; local aaJit = false; local aaJitT = 0
local function GetAACF(dt)
    if not Config.AntiAimEnabled then return nil end
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local yO = math.rad(Config.AntiAimYaw); local pO = math.rad(Config.AntiAimPitch); local bY = 0
    local m = Config.AntiAimMode
    if m == "Spin" then aaAngle = aaAngle + dt*20; bY = aaAngle
    elseif m == "Backwards" then local lv = hrp.CFrame.LookVector; bY = math.atan2(-lv.X,-lv.Z)+math.pi
    elseif m == "Backwards at Targets" then
        local cp, cd = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and IsAlive(p) and not IsTeammate(p) then
                local pH = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                if pH then local d = (pH.Position-hrp.Position).Magnitude; if d<cd then cd=d; cp=p end end
            end
        end
        if cp and cp.Character then local tH = cp.Character:FindFirstChild("HumanoidRootPart"); if tH then local d=(tH.Position-hrp.Position); bY=math.atan2(d.X,d.Z)+math.pi end
        else bY = math.atan2(-hrp.CFrame.LookVector.X,-hrp.CFrame.LookVector.Z) end
    elseif m == "Random" then bY = math.random()*math.pi*2
    elseif m == "Jitter" then aaJitT=aaJitT+dt; if aaJitT>=0.1 then aaJit=not aaJit; aaJitT=0 end; local lv=hrp.CFrame.LookVector; bY=math.atan2(-lv.X,-lv.Z)+(aaJit and 1.5 or -1.5)
    elseif m == "Custom" then bY = 0 end
    return CFrame.new(hrp.Position) * CFrame.Angles(pO, bY+yO, 0)
end

