-- ═══════════════════════════════════════
-- HITBOX FINDER
-- El juego usa hitboxes custom en workspace:
--   workspace.[PlayerName].HeadHitbox
--   workspace.[PlayerName].BodyHitbox
-- ═══════════════════════════════════════
local function GetPlayerHitboxes(player)
    -- Buscar container con el nombre del jugador en workspace
    local container = workspace:FindFirstChild(player.Name)

    -- Si no existe con el nombre exacto, buscar por DisplayName
    if not container then
        container = workspace:FindFirstChild(player.DisplayName)
    end

    -- Si aún no, buscar en todos los hijos de workspace
    if not container then
        for _, child in ipairs(workspace:GetChildren()) do
            if child.Name == player.Name or child.Name == player.DisplayName then
                container = child
                break
            end
        end
    end

    if not container then return nil, nil end

    local headHB = container:FindFirstChild("HeadHitbox")
    local bodyHB = container:FindFirstChild("BodyHitbox")

    return headHB, bodyHB
end

-- Obtener la mejor parte para apuntar según Config.AimPart
local function GetAimTarget(player)
    local headHB, bodyHB = GetPlayerHitboxes(player)

    if Config.AimPart == "Head" then
        if headHB then return headHB end
        -- Fallback al Head del character
        if player.Character then
            local h = player.Character:FindFirstChild("Head")
            if h then return h end
        end
    else
        -- Body / HRP / Torso
        if bodyHB then return bodyHB end
        if player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then return hrp end
            local torso = player.Character:FindFirstChild("UpperTorso") or player.Character:FindFirstChild("Torso")
            if torso then return torso end
        end
    end

    return headHB or bodyHB
end

-- Obtener la parte central para ESP (BodyHitbox o HRP)
local function GetESPCenter(player)
    local _, bodyHB = GetPlayerHitboxes(player)
    if bodyHB and bodyHB:IsA("BasePart") then return bodyHB end

    if player.Character then
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp end
        local _, bHB = GetPlayerHitboxes(player)
        if bHB then return bHB end
    end

    return nil
end

-- ═══════════════════════════════════════
-- UTILITIES
-- ═══════════════════════════════════════
local function GetScreenCenter()
    local vps = Camera.ViewportSize
    return Vector2.new(vps.X / 2, vps.Y / 2)
end

local function IsAlive(player)
    if not player or not player.Character then return false end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function IsTeammate(player)
    if not Config.TeamCheck then return false end
    if not LocalPlayer.Team or not player.Team then return false end
    return LocalPlayer.Team == player.Team
end

local function IsVisible(part)
    if not part then return false end
    local origin = Camera.CFrame.Position
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Blacklist
    local fl = {Camera}
    if LocalPlayer.Character then table.insert(fl, LocalPlayer.Character) end
    -- También excluir hitboxes del workspace para no bloquear raycast
    for _, p in ipairs(Players:GetPlayers()) do
        local c = workspace:FindFirstChild(p.Name)
        if c then table.insert(fl, c) end
    end
    rp.FilterDescendantsInstances = fl
    local result = workspace:Raycast(origin, part.Position - origin, rp)
    if not result then return true end
    if result.Instance:IsDescendantOf(part.Parent) then return true end
    return false
end

-- ═══════════════════════════════════════
-- TARGET SELECTION (usa hitboxes)
-- ═══════════════════════════════════════
local function GetClosestTarget()
    local closest, closestDist = nil, math.huge
    local sc = GetScreenCenter()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsAlive(p) and not IsTeammate(p) then
            local aimPart = GetAimTarget(p)
            if aimPart then
                local sp, on = Camera:WorldToViewportPoint(aimPart.Position)
                if on then
                    local sd = (Vector2.new(sp.X, sp.Y) - sc).Magnitude
                    if sd <= Config.FOV then
                        local wd = (aimPart.Position - Camera.CFrame.Position).Magnitude
                        if wd <= Config.MaxDistance and (not Config.VisualCheck or IsVisible(aimPart)) then
                            if sd < closestDist then closestDist = sd; closest = p end
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function GetTargetsInRange(range)
    local targets = {}
    local char = LocalPlayer.Character
    if not char then return targets end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local center = hrp and hrp.Position or Camera.CFrame.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsAlive(p) and not IsTeammate(p) then
            local aimPart = GetAimTarget(p)
            if aimPart and (aimPart.Position - center).Magnitude <= range then
                table.insert(targets, p)
            end
        end
    end
    return targets
end

-- ═══════════════════════════════════════
-- SHOTGUN PELLET GENERATOR
-- Genera posiciones de pellets alrededor
-- del target con spread cónico natural
-- ═══════════════════════════════════════
local function GeneratePelletPositions(targetPos, origin, pelletCount)
    local positions = {}
    local dist = (targetPos - origin).Magnitude
    -- Spread radius scales with distance (shotgun cone)
    local spreadRadius = math.max(0.3, dist * 0.015)

    for i = 1, pelletCount do
        positions[i] = targetPos + Vector3.new(
            math.random(-spreadRadius * 100, spreadRadius * 100) / 100,
            math.random(-spreadRadius * 100, spreadRadius * 100) / 100,
            math.random(-spreadRadius * 100, spreadRadius * 100) / 100
        )
    end
    return positions
end

-- ═══════════════════════════════════════
-- SILENT AIM LOGIC
--
-- Redirects:
--   args[4] = direction → toward target HeadHitbox
--   args[7] = hit positions → around target (shotgun support)
--   args[8] = final hit → target HeadHitbox position
-- ═══════════════════════════════════════
local function RedirectShootArgs(args, target)
    local aimPart = GetAimTarget(target)
    if not aimPart then return false end

    local origin = typeof(args[3]) == "Vector3" and args[3] or Camera.CFrame.Position
    local targetPos = aimPart.Position
    local newDir = (targetPos - origin).Unit

    -- args[4] = direction
    args[4] = newDir

    -- args[7] = hit positions (single or shotgun)
    if typeof(args[7]) == "table" then
        local pelletCount = #args[7]
        if pelletCount > 1 then
            -- SHOTGUN: generate spread around target
            args[7] = GeneratePelletPositions(targetPos, origin, pelletCount)
        elseif pelletCount == 1 then
            -- Single shot
            args[7] = { targetPos }
        end
    end

    -- args[8] = final hit position
    args[8] = targetPos

    return true
end

-- ═══════════════════════════════════════
-- FABRICATE SHOOT (Kill Aura / AutoShoot)
-- ═══════════════════════════════════════
local function FabricateShoot(remote, target, originOverride)
    if not remote or not target then return end
    local aimPart = GetAimTarget(target)
    if not aimPart then return end

    local origin = originOverride or Camera.CFrame.Position
    local targetPos = aimPart.Position
    local dir = (targetPos - origin).Unit

    -- Detectar si es escopeta (último disparo tuvo >1 pellet)
    local pelletCount = StoredData.lastPelletCount or 1
    local pellets = {}
    if pelletCount > 1 then
        pellets = GeneratePelletPositions(targetPos, origin, pelletCount)
    else
        pellets = { targetPos }
    end

    local shootArgs = {
        "Shoot",
        StoredData.weaponId,
        origin,
        dir,
        StoredData.flag,
        StoredData.stat,
        pellets,
        targetPos,
    }

    isModifying = true
    pcall(function()
        remote:FireServer(unpack(shootArgs))
    end)
    isModifying = false
end

-- ═══════════════════════════════════════
-- HOOK __namecall
-- ═══════════════════════════════════════
local OldNamecall
OldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    if isModifying then
        return OldNamecall(self, ...)
    end

    local method = getnamecallmethod()

    if method == "FireServer" and typeof(self) == "Instance"
       and self:IsA("RemoteEvent") and self.Name == "GunAction" then

        local args = {...}
        local actionType = args[1]

        -- Almacenar datos
        if typeof(args[2]) == "number" then StoredData.weaponId = args[2] end
        if typeof(args[3]) == "Vector3" then StoredData.origin = args[3] end
        if typeof(args[5]) == "boolean" then StoredData.flag = args[5] end
        if typeof(args[6]) == "number" then StoredData.stat = args[6] end
        if typeof(args[7]) == "table" then StoredData.lastPelletCount = #args[7] end

        -- ═══ "Shoot" ACTION ═══
        if actionType == "Shoot" then

            -- SILENT AIM
            if Config.Enabled and Config.SilentAimEnabled then
                local target = GetClosestTarget()

                if target then
                    local newArgs = {
                        args[1], args[2], args[3], args[4],
                        args[5], args[6], args[7], args[8]
                    }
                    if typeof(newArgs[7]) == "table" then
                        local cloned = {}
                        for i, v in ipairs(newArgs[7]) do cloned[i] = v end
                        newArgs[7] = cloned
                    end

                    local redirected = RedirectShootArgs(newArgs, target)

                    if redirected then
                        isModifying = true
                        local r = self:FireServer(unpack(newArgs))
                        isModifying = false

                        if Config.SilentAimDebug then
                            local aimPart = GetAimTarget(target)
                            local pellets = typeof(newArgs[7]) == "table" and #newArgs[7] or 1
                            print("[ARTEMIS] Silent → " .. target.Name .. " | " .. (aimPart and aimPart.Name or "?") .. " | " .. pellets .. " pellets")
                        end

                        return r
                    end
                end
                -- No target → dejar pasar

            -- NO SPREAD
            elseif Config.NoSpread then
                if typeof(args[3]) == "Vector3" and typeof(args[7]) == "table" and #args[7] > 0 then
                    local origin = args[3]
                    local hitPos = args[7][1]
                    if typeof(hitPos) == "Vector3" then
                        local cleanDir = (hitPos - origin).Unit
                        local newArgs = {
                            args[1], args[2], args[3], cleanDir,
                            args[5], args[6], args[7], args[8]
                        }
                        isModifying = true
                        local r = self:FireServer(unpack(newArgs))
                        isModifying = false
                        return r
                    end
                end
            end
        end
    end

    return OldNamecall(self, ...)
end))

