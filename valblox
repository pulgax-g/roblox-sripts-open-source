-- ═══════════════════════════════════════
-- ANTI-AIM SYSTEM (con Yaw/Pitch editor + Backwards at Targets)
-- ═══════════════════════════════════════
local antiAimAngle = 0
local antiAimJitterSwitch = false
local antiAimJitterTimer = 0

local function GetAntiAimCFrame(dt)
    if not Config.AntiAimEnabled then return nil end
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local mode = Config.AntiAimMode
    local yawOffset = math.rad(Config.AntiAimYaw)
    local pitchOffset = math.rad(Config.AntiAimPitch)

    local baseYaw = 0

    if mode == "Spin" then
        antiAimAngle = antiAimAngle + dt * 20
        baseYaw = antiAimAngle

    elseif mode == "Backwards" then
        local lv = hrp.CFrame.LookVector
        baseYaw = math.atan2(-lv.X, -lv.Z) + math.pi

    elseif mode == "Backwards at Targets" then
        -- Mira HACIA el target más cercano, luego gira 180° (le da la espalda)
        local closestPlayer = nil
        local closestDist = math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and IsAlive(p) and not IsTeammate(p) then
                local pChar = p.Character
                local pHRP = pChar and pChar:FindFirstChild("HumanoidRootPart")
                if pHRP then
                    local d = (pHRP.Position - hrp.Position).Magnitude
                    if d < closestDist then
                        closestDist = d
                        closestPlayer = p
                    end
                end
            end
        end
        if closestPlayer and closestPlayer.Character then
            local targetHRP = closestPlayer.Character:FindFirstChild("HumanoidRootPart")
            if targetHRP then
                local dir = (targetHRP.Position - hrp.Position)
                local angleToTarget = math.atan2(dir.X, dir.Z)
                baseYaw = angleToTarget + math.pi -- 180° backwards
            else
                baseYaw = math.atan2(-hrp.CFrame.LookVector.X, -hrp.CFrame.LookVector.Z)
            end
        else
            baseYaw = math.atan2(-hrp.CFrame.LookVector.X, -hrp.CFrame.LookVector.Z)
        end

    elseif mode == "Random" then
        baseYaw = math.random() * math.pi * 2

    elseif mode == "Jitter" then
        antiAimJitterTimer = antiAimJitterTimer + dt
        if antiAimJitterTimer >= 0.1 then
            antiAimJitterSwitch = not antiAimJitterSwitch
            antiAimJitterTimer = 0
        end
        local lv = hrp.CFrame.LookVector
        local base = math.atan2(-lv.X, -lv.Z)
        baseYaw = base + (antiAimJitterSwitch and 1.5 or -1.5)

    elseif mode == "Custom" then
        -- Solo usa los offsets de Yaw/Pitch, sin rotación base adicional
        baseYaw = 0
    end

    local finalYaw = baseYaw + yawOffset

    -- Construir CFrame con pitch y yaw
    local pos = hrp.Position
    local yawCF = CFrame.new(pos) * CFrame.Angles(0, finalYaw, 0)
    local finalCF = yawCF * CFrame.Angles(pitchOffset, 0, 0)

    return finalCF
end

