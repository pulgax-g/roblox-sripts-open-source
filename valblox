RunService.RenderStepped:Connect(function(dt)
    -- FOV Circle → CENTRO DE LA PANTALLA
    local screenCenter = GetScreenCenter()
    FOVCircle.Position = screenCenter
    FOVCircle.Radius = Config.FOV
    FOVCircle.Visible = Config.Enabled and Config.ShowFOV

    -- ESP Update
    for player, _ in pairs(ESPObjects) do
        UpdateESP(player)
    end

    -- Aimbot (right-click hold)
    if Config.Enabled and Config.AimbotEnabled and rightMouseDown then
        local target = GetClosestTarget()
        if target and target.Character then
            local aimPart = target.Character:FindFirstChild(Config.AimPart) or target.Character:FindFirstChild("Head")
            if aimPart then
                local screenPos, onScreen = Camera:WorldToViewportPoint(aimPart.Position)
                if onScreen then
                    local center = GetScreenCenter()
                    local dx = (screenPos.X - center.X) / Config.AimSmooth
                    local dy = (screenPos.Y - center.Y) / Config.AimSmooth
                    mousemoverel(dx, dy)
                end
            end
        end
    end

    -- Anti-Aim
    if Config.Enabled and Config.AntiAimEnabled then
        local newCF = GetAntiAimCFrame(dt)
        if newCF then
            local char = LocalPlayer.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = CFrame.new(hrp.Position) * (newCF - newCF.Position)
                end
            end
        end
    end
end)

