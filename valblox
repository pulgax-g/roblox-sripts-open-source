-- ═══════════════════════════════════════
-- UTILITY FUNCTIONS
-- ═══════════════════════════════════════
local function GetScreenCenter()
    local vps = Camera.ViewportSize
    return Vector2.new(vps.X / 2, vps.Y / 2)
end

local function IsAlive(player)
    if not player or not player.Character then return false end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function IsTeammate(player)
    if not Config.TeamCheck then return false end
    if not LocalPlayer.Team or not player.Team then return false end
    return LocalPlayer.Team == player.Team
end

local function IsVisible(part)
    if not part then return false end
    local origin = Camera.CFrame.Position
    local direction = (part.Position - origin)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    local filterList = {Camera}
    if LocalPlayer.Character then table.insert(filterList, LocalPlayer.Character) end
    rayParams.FilterDescendantsInstances = filterList

    local result = workspace:Raycast(origin, direction, rayParams)
    if not result then return true end
    if result.Instance:IsDescendantOf(part.Parent) then return true end
    return false
end

-- ═══════════════════════════════════════
-- TARGET SELECTION (SCREEN CENTER FOV)
-- ═══════════════════════════════════════
local function GetClosestTarget()
    local closest = nil
    local closestDist = math.huge
    local screenCenter = GetScreenCenter()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsAlive(player) and not IsTeammate(player) then
            local char = player.Character
            local aimPart = char:FindFirstChild(Config.AimPart) or char:FindFirstChild("Head")
            if aimPart then
                local screenPos, onScreen = Camera:WorldToViewportPoint(aimPart.Position)
                if onScreen then
                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if screenDist <= Config.FOV then
                        local worldDist = (aimPart.Position - Camera.CFrame.Position).Magnitude
                        if worldDist <= Config.MaxDistance then
                            if not Config.VisualCheck or IsVisible(aimPart) then
                                if screenDist < closestDist then
                                    closestDist = screenDist
                                    closest = player
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

-- ═══════════════════════════════════════
-- SILENT AIM - FIRE CLEAN SHOT
-- ═══════════════════════════════════════
local function FireCleanShot(gun, origin, target, aimPart)
    if not gun or not origin or not target or not target.Character or not aimPart then return end
    local targetPos = aimPart.Position
    local direction = (targetPos - origin).Unit
    isModifying = true
    pcall(function()
        ShootRemote:FireServer(
            gun,
            direction,
            origin,
            target.Character,
            aimPart,
            targetPos,
            targetPos + Vector3.new(math.random(-3, 3) / 100, math.random(-3, 3) / 100, math.random(-3, 3) / 100),
            nil
        )
    end)
    isModifying = false
end

-- ═══════════════════════════════════════
-- HOOK __namecall (SILENT AIM + NO SPREAD)
-- ═══════════════════════════════════════
local OldNamecall
OldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    if isModifying then
        return OldNamecall(self, ...)
    end

    local method = getnamecallmethod()

    if method == "FireServer" and typeof(self) == "Instance" and self:IsA("RemoteEvent") and self.Name == "ShootRemote" then
        local args = {...}

        if typeof(args[1]) == "Instance" then LastKnownGun = args[1] end
        if typeof(args[3]) == "Vector3" then LastKnownOrigin = args[3] end

        -- NoSpread (solo cuando Silent OFF)
        if Config.NoSpread and not Config.SilentAimEnabled then
            if typeof(args[3]) == "Vector3" and typeof(args[6]) == "Vector3" then
                local perfectDir = (args[6] - args[3]).Unit
                isModifying = true
                local r = self:FireServer(args[1], perfectDir, args[3], args[4], args[5], args[6], args[7], args[8])
                isModifying = false
                return r
            end
        end

        -- Silent Aim ON → bloquear y re-disparar
        if Config.Enabled and Config.SilentAimEnabled then
            local target = GetClosestTarget()
            if target and target.Character then
                local aimPart = target.Character:FindFirstChild(Config.AimPart) or target.Character:FindFirstChild("Head")
                if aimPart and typeof(args[3]) == "Vector3" then
                    FireCleanShot(args[1], args[3], target, aimPart)

                    if Config.SilentAimDebug then
                        print("[ARTEMIS] Silent → " .. target.Name)
                    end

                    return nil
                end
            else
                return nil
            end
        end
    end

    return OldNamecall(self, ...)
end))

