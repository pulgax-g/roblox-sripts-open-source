            if target and target.Character then
                if Config.SilentAimEnabled and ShootRemote and LastKnownGun and LastKnownOrigin then
                    local aimPart = target.Character:FindFirstChild(Config.AimPart) or target.Character:FindFirstChild("Head")
                    if aimPart then
                        local originNow = Camera.CFrame.Position
                        FireCleanShot(LastKnownGun, originNow, target, aimPart)
                    end
                else
                    pcall(function() mouse1click() end)
                end
            end
        end
    end
end)

