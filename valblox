-- ESP SYSTEM (3D BOXES)
-- ═══════════════════════════════════════
local function CreateESP(player)
    if ESPObjects[player] then return end

    local obj = {lines = {}, name = nil, health = nil, distance = nil, tracer = nil, healthbar = nil, healthbarBG = nil}

    for i = 1, 12 do
        local line = Drawing.new("Line")
        line.Thickness = 1.2
        line.Color = Colors.accent
        line.Visible = false
        obj.lines[i] = line
    end

    obj.name = Drawing.new("Text")
    obj.name.Size = 14
    obj.name.Center = true
    obj.name.Outline = true
    obj.name.Color = Colors.white
    obj.name.Visible = false

    obj.health = Drawing.new("Text")
    obj.health.Size = 13
    obj.health.Center = false
    obj.health.Outline = true
    obj.health.Color = Colors.green
    obj.health.Visible = false

    obj.distance = Drawing.new("Text")
    obj.distance.Size = 13
    obj.distance.Center = true
    obj.distance.Outline = true
    obj.distance.Color = Colors.yellow
    obj.distance.Visible = false

    obj.tracer = Drawing.new("Line")
    obj.tracer.Thickness = 1.2
    obj.tracer.Color = Colors.accent
    obj.tracer.Visible = false

    obj.healthbarBG = Drawing.new("Line")
    obj.healthbarBG.Thickness = 3
    obj.healthbarBG.Color = Color3.fromRGB(40, 40, 40)
    obj.healthbarBG.Visible = false

    obj.healthbar = Drawing.new("Line")
    obj.healthbar.Thickness = 2
    obj.healthbar.Color = Colors.green
    obj.healthbar.Visible = false

    ESPObjects[player] = obj
end

local function ClearESP(player)
    local obj = ESPObjects[player]
    if not obj then return end
    for _, line in ipairs(obj.lines) do pcall(function() line:Remove() end) end
    for _, key in ipairs({"name", "health", "distance", "tracer", "healthbar", "healthbarBG"}) do
        if obj[key] then pcall(function() obj[key]:Remove() end) end
    end
    ESPObjects[player] = nil
end

local function UpdateESP(player)
    local obj = ESPObjects[player]
    if not obj then return end

    if not Config.Enabled or not Config.ESPEnabled or player == LocalPlayer or not IsAlive(player) or IsTeammate(player) then
        for _, line in ipairs(obj.lines) do line.Visible = false end
        obj.name.Visible = false
        obj.health.Visible = false
        obj.distance.Visible = false
        obj.tracer.Visible = false
        obj.healthbar.Visible = false
        obj.healthbarBG.Visible = false
        return
    end

    local char = player.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head")
    if not hrp or not hum or not head then
        for _, line in ipairs(obj.lines) do line.Visible = false end
        obj.name.Visible = false
        obj.health.Visible = false
        obj.distance.Visible = false
        obj.tracer.Visible = false
        obj.healthbar.Visible = false
        obj.healthbarBG.Visible = false
        return
    end

    local dist = (hrp.Position - Camera.CFrame.Position).Magnitude
    if dist > Config.ESPMaxDistance then
        for _, line in ipairs(obj.lines) do line.Visible = false end
        obj.name.Visible = false
        obj.health.Visible = false
        obj.distance.Visible = false
        obj.tracer.Visible = false
        obj.healthbar.Visible = false
        obj.healthbarBG.Visible = false
        return
    end

    if Config.ESPVisibleCheck and not IsVisible(head) then
        for _, line in ipairs(obj.lines) do line.Visible = false end
        obj.name.Visible = false
        obj.health.Visible = false
        obj.distance.Visible = false
        obj.tracer.Visible = false
        obj.healthbar.Visible = false
        obj.healthbarBG.Visible = false
        return
    end

    local isVisible = IsVisible(head)
    local boxColor = isVisible and Colors.green or Colors.red

    -- 3D box
    local halfY = hum.RigType == Enum.HumanoidRigType.R15 and 2.75 or 2.5
    local halfX = 1.2
    local halfZ = 1.0
    local cf = hrp.CFrame

    local corners3D = {
        cf * CFrame.new(-halfX, halfY, -halfZ),
        cf * CFrame.new(halfX, halfY, -halfZ),
        cf * CFrame.new(halfX, halfY, halfZ),
        cf * CFrame.new(-halfX, halfY, halfZ),
        cf * CFrame.new(-halfX, -halfY, -halfZ),
        cf * CFrame.new(halfX, -halfY, -halfZ),
        cf * CFrame.new(halfX, -halfY, halfZ),
        cf * CFrame.new(-halfX, -halfY, halfZ),
    }

    local corners2D = {}
    local allOnScreen = true
    for i, c in ipairs(corners3D) do
        local sp, onScr = Camera:WorldToViewportPoint(c.Position)
        if not onScr then allOnScreen = false; break end
        corners2D[i] = Vector2.new(sp.X, sp.Y)
    end

    if not allOnScreen then
        for _, line in ipairs(obj.lines) do line.Visible = false end
        obj.name.Visible = false
        obj.health.Visible = false
        obj.distance.Visible = false
        obj.tracer.Visible = false
        obj.healthbar.Visible = false
        obj.healthbarBG.Visible = false
        return
    end

    local edges = {
        {1,2},{2,3},{3,4},{4,1},
        {5,6},{6,7},{7,8},{8,5},
        {1,5},{2,6},{3,7},{4,8},
    }

    if Config.ESPBoxes then
        for i, edge in ipairs(edges) do
            obj.lines[i].From = corners2D[edge[1]]
            obj.lines[i].To = corners2D[edge[2]]
            obj.lines[i].Color = boxColor
            obj.lines[i].Visible = true
        end
    else
        for _, line in ipairs(obj.lines) do line.Visible = false end
    end

    -- Bounding box 2D para posicionar textos
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    for _, c in ipairs(corners2D) do
        if c.X < minX then minX = c.X end
        if c.Y < minY then minY = c.Y end
        if c.X > maxX then maxX = c.X end
        if c.Y > maxY then maxY = c.Y end
    end

    -- Name
    if Config.ESPNames then
        obj.name.Text = player.DisplayName
        obj.name.Position = Vector2.new((minX + maxX) / 2, minY - 18)
        obj.name.Color = Colors.white
        obj.name.Visible = true
    else
        obj.name.Visible = false
    end

    -- Distance
    if Config.ESPDistance then
        obj.distance.Text = math.floor(dist) .. "m"
        obj.distance.Position = Vector2.new((minX + maxX) / 2, maxY + 3)
        obj.distance.Color = Colors.yellow
        obj.distance.Visible = true
    else
        obj.distance.Visible = false
    end

    -- Health bar (left side)
    if Config.ESPHealth then
        local healthPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        local barHeight = maxY - minY
        local barX = minX - 6

        obj.healthbarBG.From = Vector2.new(barX, minY)
        obj.healthbarBG.To = Vector2.new(barX, maxY)
        obj.healthbarBG.Visible = true

        obj.healthbar.From = Vector2.new(barX, maxY)
        obj.healthbar.To = Vector2.new(barX, maxY - barHeight * healthPct)
        obj.healthbar.Color = Color3.fromRGB(255 * (1 - healthPct), 255 * healthPct, 50)
        obj.healthbar.Visible = true

        obj.health.Text = math.floor(hum.Health) .. "hp"
        obj.health.Position = Vector2.new(maxX + 4, minY)
        obj.health.Color = Color3.fromRGB(255 * (1 - healthPct), 255 * healthPct, 50)
        obj.health.Visible = true
    else
        obj.health.Visible = false
        obj.healthbar.Visible = false
        obj.healthbarBG.Visible = false
    end

    -- Tracer
    if Config.ESPTracers then
        local vps = Camera.ViewportSize
        local tracerStart
        if Config.TracerOrigin == "Top" then
            tracerStart = Vector2.new(vps.X / 2, 0)
        elseif Config.TracerOrigin == "Center" then
            tracerStart = Vector2.new(vps.X / 2, vps.Y / 2)
        else
            tracerStart = Vector2.new(vps.X / 2, vps.Y)
        end
        obj.tracer.From = tracerStart
        obj.tracer.To = Vector2.new((minX + maxX) / 2, maxY)
        obj.tracer.Color = boxColor
        obj.tracer.Visible = true
    else
        obj.tracer.Visible = false
    end
end

